# Ariba Shield WAF gateway — nginx config template (http-level content)
# Rendered by the policy-compiler service. Included from the main nginx.conf
# via `include /etc/nginx/conf.d/*.conf;`.
# WARNING: This file is auto-generated. Do not edit manually.

    # Basic settings
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 30s;
    keepalive_requests 1000;
    reset_timedout_connection on;
    client_body_timeout 10s;
    client_header_timeout 10s;
    send_timeout 10s;
    types_hash_max_size 2048;

    # Logging
    log_format shield_json escape=json '{'
        '"schema_version":"0.1",'
        '"event_id":"$shield_request_id",'  # placeholder; gateway generates ULID
        '"request_id":"$shield_request_id",'
        '"timestamp":"$time_iso8601",'
        '"event_type":"access",'
        '"gateway_id":"{{.GatewayID}}",'
        '"virtual_server_id":"{{.VirtualServerID}}",'
        '"application_id":"{{.ApplicationID}}",'
        '"client":{'
            '"ip":"$remote_addr",'
            '"port":$remote_port,'
            '"forwarded_for":"$http_x_forwarded_for"'
        '},'
        '"request":{'
            '"method":"$request_method",'
            '"path":"$uri",'
            '"query":"$args",'
            '"http_version":"$server_protocol",'
            '"host":"$host",'
            '"content_type":"$sent_http_content_type",'
            '"body_size":$body_bytes_sent,'
            '"headers_count":0'
        '},'
        '"response":{'
            '"status":$status,'
            '"bytes":$body_bytes_sent,'
            '"latency_ms":$request_time,'
            '"backend_node":"$upstream_addr"'
        '},'
        '"decision":{"action":"pass"}'
    '}';

    access_log /var/log/shield-waf/access.log shield_json buffer=64k flush=5s;
    access_log /dev/stdout shield_json;

    {{range .Upstreams}}
    upstream {{.Name}} {
        {{if .LeastConn}}least_conn;{{end}}
        {{if .IPHash}}ip_hash;{{end}}
        {{if .ConsistentHash}}hash $request_uri consistent;{{end}}
        {{range .Servers}}
        server {{.Host}}:{{.Port}} weight={{.Weight}} max_fails={{.MaxFails}} fail_timeout={{.FailTimeout}}s;
        {{end}}
        keepalive 32;
    }
    {{end}}

    {{range .Servers}}
    server {
        listen {{.ListenAddr}}:{{.ListenPort}}{{if .SSL}} ssl{{end}};
        {{if .SSL}}http2 {{if .HTTP2}}on{{else}}off{{end}};{{end}}
        server_name {{.ServerName}};

        {{if .SSL}}
        ssl_certificate {{.SSLCertPath}};
        ssl_certificate_key {{.SSLKeyPath}};
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
        ssl_prefer_server_ciphers off;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;
        {{end}}

        # Request ID
        set $shield_request_id "";
        if ($http_x_request_id != "") {
            set $shield_request_id $http_x_request_id;
        }

        # Trusted proxy headers
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Request-ID $shield_request_id;
        proxy_set_header Host $host;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 30s;
        proxy_connect_timeout 5s;

        # Size limits
        client_max_body_size {{.MaxBodySize}};
        client_header_buffer_size 8k;
        large_client_header_buffers 4 {{.MaxHeaderSize}};

        {{range .Locations}}
        location {{.Path}} {
            proxy_pass {{if eq .Scheme "https"}}https://{{else}}http://{{end}}{{.Upstream}};
            {{if eq .Scheme "https"}}proxy_ssl_server_name on;{{end}}
            {{if .Timeout}}proxy_read_timeout {{.Timeout}};{{end}}
        }
        {{end}}

        # Health check endpoint
        location /shield-health {
            access_log off;
            return 200 "ok\n";
            add_header Content-Type text/plain;
        }
    }
    {{end}}