{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariba-shield.dev/schema/event-v0.json",
  "title": "Event Document v0",
  "description": "Structured security event record with flat fields matching the API and DB representation. Additive-only (ADR-002 D3). Events never contain request bodies, cookies, or credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "event_id", "request_id", "timestamp", "severity",
    "decision_action", "reason", "rule_ids", "client_ip", "method", "path", "status", "created_at"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/ulid" },
    "event_id": { "$ref": "#/$defs/ulid" },
    "request_id": { "$ref": "#/$defs/ulid" },
    "timestamp": { "$ref": "#/$defs/timestamp" },
    "severity": { "type": "string" },
    "decision_action": { "type": "string" },
    "reason": { "type": "string" },
    "rule_ids": { "type": "array", "items": { "type": "string" } },
    "client_ip": { "type": "string", "format": "ipv4" },
    "method": { "type": "string" },
    "path": { "type": "string" },
    "status": { "type": "integer", "minimum": 100, "maximum": 599 },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "gateway_id": { "type": "string" },
    "application_id": { "type": "string" },
    "virtual_server_id": { "type": "string" },
    "host": { "type": "string" },
    "masked": { "type": "boolean", "default": true },
    "match_details": {
      "type": "array",
      "description": "Matched rule details emitted by the engine (map of string to string per matched rule).",
      "items": { "type": "object", "additionalProperties": { "type": "string" } }
    }
  },
  "$defs": {
    "ulid": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$", "description": "ULID, 26 char Crockford base32" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}